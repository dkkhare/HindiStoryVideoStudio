# Copy this file to .env and set your own credentials/paths.
GEMINI_API_KEY=

# ComfyUI image and video services
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_CLIENT_ID=hindi-story-studio
COMFYUI_WORKFLOW_JSON=./workflows/ltx25_i2v_api.json

# Export your generic scene-image workflow from ComfyUI (File > Export (API)).
# Save it here, or replace this with the absolute path to your exported JSON.
COMFYUI_IMAGE_WORKFLOW_JSON=./workflows/automatic_reference_api.json
SCENE_IMAGE_PROVIDER=comfyui
COMFYUI_IMAGE_TIMEOUT_SECONDS=900

# Local F5-TTS service
F5TTS_BASE_URL=http://127.0.0.1:7860
F5TTS_API_PATH=/api/predict
DEFAULT_TTS_PROVIDER=f5tts
