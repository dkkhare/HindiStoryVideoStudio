# Local environment configuration. Copy this file to .env and fill in your own keys.
# Never commit .env or paste secrets into chat.

# Gemini
GEMINI_API_KEY=

# Kaggle-hosted ComfyUI (Cloudflare Tunnel)
COMFYUI_BASE_URL=https://beliefs-insights-valuable-restrictions.trycloudflare.com
COMFYUI_API_KEY=PUT_YOUR_KAGGLE_API_KEY_HERE
COMFYUI_CLIENT_ID=hindi-story-studio
COMFYUI_WORKFLOW_JSON=./workflows/ltx25_i2v_api.json
COMFYUI_REQUEST_TIMEOUT_SECONDS=2700

# Video generation defaults
DEFAULT_FPS=24
DEFAULT_VIDEO_SCENE_SECONDS=15

# Audio generation provider: gemini, voicebox, or voicestudio
# Gemini API
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Local Voicebox
VOICEBOX_BASE_URL=http://127.0.0.1:17493
VOICEBOX_ENGINE=chatterbox
VOICEBOX_TIMEOUT_SECONDS=600
VOICEBOX_GENERATION_TIMEOUT_SECONDS=600

# Local OpenAI-compatible Voice Studio
VOICESTUDIO_BASE_URL=http://127.0.0.1:3900/v1
VOICESTUDIO_API_KEY=local
VOICESTUDIO_MODEL=tts-1
VOICESTUDIO_VOICES=alloy,echo,fable,onyx,nova,shimmer
VOICESTUDIO_TIMEOUT_SECONDS=600
