# Local environment configuration. Copy this file to .env and fill in your own keys.
# Never commit .env or paste secrets into chat.

# Gemini
GEMINI_API_KEY=

# Kaggle worker URLs and API keys are registered in the Video Production panel.
# API keys are encrypted and stored in the application database.
COMFYUI_WORKFLOW_JSON=./workflows/ltx25_i2v_api.json
COMFYUI_REQUEST_TIMEOUT_SECONDS=2700

# Video generation defaults
DEFAULT_FPS=24
DEFAULT_VIDEO_SCENE_SECONDS=15

# Local Voicebox / TTS
VOICEBOX_BASE_URL=http://127.0.0.1:17493
VOICEBOX_ENGINE=chatterbox
VOICEBOX_TIMEOUT_SECONDS=600
VOICEBOX_GENERATION_TIMEOUT_SECONDS=600
